# 게이트웨이 주소 (개발 서버의 /api 프록시가 여기로 넘긴다)
VITE_API_PROXY_TARGET=http://localhost:8080

# ingest 주소 (관리자 운영 화면의 「공사 데이터 최신 수집」을 개발 서버가 ingest 의 수집 입구로 넘긴다)
# 게이트웨이에 관리자 수집 입구가 열리면 쓰지 않게 된다
VITE_INGEST_PROXY_TARGET=http://localhost:8088

# 카카오맵 JS SDK 키 — 카카오 개발자 콘솔의 JavaScript 키 (REST API 키가 아님)
# 그 키의 JavaScript SDK 도메인에 http://localhost:5173 · http://localhost:4173 을 포트까지 등록하고
# [제품 설정] > 카카오맵 을 켜야 한다 · 비우면 지도 자리에 약도를 그린다
VITE_KAKAO_MAP_JS_KEY=

# 후기 저장 방식 — local (브라우저 저장소) 또는 remote (review 서버)
VITE_REVIEW_MODE=local

# 처음 쓸 지역 — 지역을 아직 고르지 않았을 때 검색 · 날씨의 기준 (시도 코드 · 시군구 이름)
VITE_FALLBACK_SIDO_CODE=11
VITE_FALLBACK_SIGUNGU_NAME=마포구
